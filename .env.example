# ── REQUIRED ──
TELEGRAM_BOT_TOKEN=        # from @BotFather
ALLOWED_CHAT_ID=           # send /chatid to bot to get this

# ── BACKEND ──
BACKEND_PROVIDER=claude    # 'claude' or 'codex'

# ── AUTH (pick one, for BACKEND_PROVIDER=claude) ──
# Option 1: API key (simplest)
ANTHROPIC_API_KEY=         # https://console.anthropic.com/settings/keys
# Option 2: CLI login (no key needed)
# Run: docker compose run --rm claudeclaw login

# ── CODEX (when BACKEND_PROVIDER=codex) ──
CODEX_PROVIDER=openai      # 'openai' or 'azure'
CODEX_MODEL=               # optional, e.g. gpt-5-codex; blank = CLI default

# OpenAI direct (CODEX_PROVIDER=openai)
OPENAI_API_KEY=            # https://platform.openai.com/api-keys

# Azure OpenAI (CODEX_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=     # https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=      # API key from Azure Foundry deployment

# ── PERSONALIZATION ──
ASSISTANT_NAME=Jarvis      # your bot's name
USER_NAME=                 # your name

# ── OPTIONAL ──
GROQ_API_KEY=              # voice transcription (console.groq.com)
GOOGLE_API_KEY=            # video analysis (aistudio.google.com)

# ── REMOTE CONTROL ──
# Access from claude.ai/code and Claude mobile app.
# Requires OAuth login: docker compose run --rm claude-claw login
ENABLE_RC=0                # set to 1 to enable
RC_SESSION_NAME=ClaudeClaw # session title in claude.ai
RC_SPAWN_MODE=             # same-dir (default), worktree, or session
RC_CAPACITY=               # max concurrent sessions (default 32)
RC_VERBOSE=0               # 1 for detailed logs
RC_SANDBOX=                # 1 for --sandbox, 0 for --no-sandbox
